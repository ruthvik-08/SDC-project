    {
      "name": "2. Machine Learning Predictions",
      "item": [
        {
          "name": "POST Predict Full 14 Features & Save History (/predict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"Telangana\",\n  \"district\": \"Khammam\",\n  \"farmer_name\": \"Suresh Reddy\",\n  \"farmer_phone\": \"9876543210\",\n  \"farmer_village\": \"Kothagudem\",\n  \"temperature\": 34.0,\n  \"temp_max\": 39.5,\n  \"temp_min\": 26.5,\n  \"rainfall\": 0.0,\n  \"humidity\": 40.0,\n  \"effective_soil_wetness\": 0.30,\n  \"solar_radiation\": 21.5,\n  \"soil_ph\": 7.4,\n  \"soil_organic_carbon\": 0.48,\n  \"ndvi\": 0.56,\n  \"et0\": 5.2,\n  \"etc\": 5.7,\n  \"crop_type\": \"Cotton\",\n  \"growth_stage\": \"Reproductive\"\n}"
