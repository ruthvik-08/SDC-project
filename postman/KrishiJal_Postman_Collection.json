{
  "info": {
    "_postman_id": "krishijal-fastapi-mysql-v2",
    "name": "KrishiJal - Crop Stress, Irrigation Priority & MySQL API",
    "description": "Complete Postman Collection for the KrishiJal FastAPI Backend, ML Inference, Geospatial Analytics, and MySQL Farmer Records CRUD.\nSupports Localhost (http://127.0.0.1:8000) and Render production using the {{base_url}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "farmer_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "prediction_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & System Checks",
      "item": [
        {
          "name": "GET Project Overview (/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "GET API & ML Model Health (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "GET MySQL Database Health (/api/db/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/db/health",
              "host": ["{{base_url}}"],
              "path": ["api", "db", "health"]
            }
          }
