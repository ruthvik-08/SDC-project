{
  "info": {
    "_postman_id": "krishijal-deployment-fastapi-v2",
    "name": "KrishiJal - Crop Stress & Irrigation Priority Decision Support API",
    "description": "Postman Collection for KrishiJal FastAPI Backend & Public Deployment.\nSupports testing against Localhost (http://127.0.0.1:8000) and Public Ngrok (https://<your-id>.ngrok-free.dev) using the {{base_url}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Deployment & Health Checks",
      "item": [
        {
          "name": "GET Project Information (/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Displays KrishiJal project details, active models, stakeholders, and full endpoint directory."
          },
          "response": []
        },
        {
          "name": "GET API & Model Health (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifies whether the FastAPI service and trained ML models (Random Forest Classifier & Regressor) are loaded and operational."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Machine Learning Predictions (/predict)",
      "item": [
        {
          "name": "POST Predict - Valid Agricultural Features (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cwsi\": 0.35,\n  \"effective_soil_wetness\": 0.40,\n  \"water_deficit\": 1.50,\n  \"ndvi\": 0.60,\n  \"et0\": 4.80,\n  \"etc\": 5.20,\n  \"temperature\": 30.0,\n  \"rainfall\": 0.0,\n  \"humidity\": 50.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/predict",
              "host": ["{{base_url}}"],
              "path": ["predict"]
            },
            "description": "Passes authentic agronomic features to the loaded Scikit-Learn models. Returns both Crop Stress classification (Low, Moderate, High, Severe) and Irrigation Priority regression index with farmer advisories."
          },
          "response": []
        },
        {
          "name": "POST Predict - Missing Inputs (422 Error Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cwsi\": 0.35,\n  \"temperature\": 30.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/predict",
              "host": ["{{base_url}}"],
              "path": ["predict"]
            },
            "description": "Omits mandatory input features to verify that FastAPI and Pydantic handle missing inputs properly with HTTP 422 Unprocessable Entity."
          },
          "response": []
        },
        {
          "name": "POST Predict - Invalid Data Type (422 Error Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cwsi\": \"not_a_number\",\n  \"effective_soil_wetness\": 0.40,\n  \"water_deficit\": 1.50,\n  \"ndvi\": 0.60,\n  \"et0\": 4.80,\n  \"etc\": 5.20,\n  \"temperature\": 30.0,\n  \"rainfall\": 0.0,\n  \"humidity\": 50.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/predict",
              "host": ["{{base_url}}"],
              "path": ["predict"]
            },
            "description": "Sends string instead of float for 'cwsi' to verify Pydantic data validation with HTTP 422."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Nationwide Dataset & Directory Endpoints",
      "item": [
        {
          "name": "GET Master Dataset Info (/api/dataset/info)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dataset/info",
              "host": ["{{base_url}}"],
              "path": ["api", "dataset", "info"]
            },
            "description": "Returns national agricultural summary statistics, state lists, and district counts."
          },
          "response": []
        },
        {
          "name": "GET 159 Districts Directory (/api/districts)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/districts",
              "host": ["{{base_url}}"],
              "path": ["api", "districts"]
            },
            "description": "Lists all 159 districts across all 37 Indian States and UTs with agro-climatic indicators."
          },
          "response": []
        },
        {
          "name": "GET Irrigation Priority Ranked List (/api/irrigation/priority)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/irrigation/priority",
              "host": ["{{base_url}}"],
              "path": ["api", "irrigation", "priority"]
            },
            "description": "Returns all 159 districts sorted in strict descending order of irrigation urgency."
          },
          "response": []
        },
        {
          "name": "GET Model Evaluation Metrics (/api/models/evaluation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/models/evaluation",
              "host": ["{{base_url}}"],
              "path": ["api", "models", "evaluation"]
            },
            "description": "Returns benchmark test-set evaluation metrics for all algorithms."
          },
          "response": []
        }
      ]
    }
  ]
}
